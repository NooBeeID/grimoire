# Salin ke .env. Nilai komentar = default.
DATABASE_URL=postgres://grimoire:grimoire@localhost:5432/grimoire?sslmode=disable
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-byte
COOKIE_SECURE=false
APP_ENV=development
# HTTP_ADDR=:8080
# AUDIT_RETENTION_DAYS=90
