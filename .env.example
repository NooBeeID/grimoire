# LOG_FORMAT=json
# DEV_VITE_URL=http://localhost:5173
# SESSION_IDLE_TIMEOUT=12h
# SESSION_ABSOLUTE_TIMEOUT=168h
# PASSWORD_MIN_LENGTH=10
# ARGON2_MEMORY_KIB=65536
# ARGON2_ITERATIONS=3
# ARGON2_PARALLELISM=2
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW=15m
# LOGIN_LOCK_DURATION=15m
# LOGIN_RATE_PER_MINUTE=20
# API_KEY_MAX_ACTIVE_PER_PROJECT=20
PUBLIC_URL=http://localhost:5173
# APISPEC_MAX_FILE_BYTES=5242880
# APISPEC_MAX_SPECS=100
# MCP_RATE_PER_MINUTE=120
# MCP_AUTH_FAIL_PER_MINUTE=20
# MCP_MAX_REQUEST_BYTES=65536
# MCP_TOOL_TIMEOUT=10s
# MCP_ALLOWED_ORIGINS=
# Email undangan (T12). Dev lokal: Mailpit (docker compose -f docker-compose.dev.yml up mailpit), UI di http://localhost:8025.
# Kosongkan MAIL_DRIVER untuk menjalankan tanpa email (kredensial dikembalikan di respons). `log` hanya untuk development.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=Grimoire <no-reply@grimoire.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_TIMEOUT=10s
# INVITATION_TTL=168h
# INVITATION_MAX_PER_HOUR=20
# INVITATION_RESEND_MAX_PER_HOUR=3
# INVITATION_PURGE_AFTER=720h

