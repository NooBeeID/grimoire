# syntax=docker/dockerfile:1

# --- Frontend ---
FROM --platform=$BUILDPLATFORM node:22-alpine AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Backend (FE ter-embed, setara `make build`) ---
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS backend
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
COPY --from=frontend /src/frontend/dist/ ./internal/infra/static/dist/
ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -tags timetzdata \
    -ldflags "-s -w \
      -X grimoire/cmd/internal/buildinfo.Version=${VERSION} \
      -X grimoire/cmd/internal/buildinfo.Commit=${COMMIT} \
      -X grimoire/cmd/internal/buildinfo.BuildDate=${DATE}" \
    -o /out/grimoire ./cmd/cli

# --- Runtime (scratch: hanya binary + CA certs; zona waktu ter-embed via timetzdata) ---
FROM scratch
COPY --from=backend /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend /out/grimoire /grimoire
USER 10001:10001
ENV APP_ENV=production \
    HTTP_ADDR=:8080
EXPOSE 8080
ENTRYPOINT ["/grimoire"]
CMD ["serve"]
